<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="consolidate_material_request_form" model="ir.ui.view">
        <field name="name">consolidate.material.request.form</field>
        <field name="model">consolidate.material.request</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" required="1"/>
                        </group>
                        <group/>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="consolidate_material_request_line_ids">               <!-- add  context="{'default_field' : field}" to set default value -->
                                <list editable="bottom">
<!--                                    <field name="project" />       &lt;!&ndash; add  domain="[('id','=',parent.field)]" to set default domain &ndash;&gt;-->
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="demand" force_save="1" readonly="1"/>
                                    <field name="request"/>
                                    <field name="remaining" force_save="1"/>
                                    <field name="material_request_id" invisible="1"/>
                                </list>
                            </field>

                        </page>
                    </notebook>

                </sheet>
                <footer>
                    <button name="confirm" type="object" string="Confirm" class="oe_highlight" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="consolidate_material_request_action">
        <field name="name">Consolidate Material Request</field>
        <field name="res_model">consolidate.material.request</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
