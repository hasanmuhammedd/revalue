<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_stock_quant_tree" model="ir.ui.view">
        <field name="name">inherit.stock.quant.tree</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="hide_set_button"/>
            </xpath>
            <xpath expr="//button[@name='action_apply_inventory']" position="attributes">
                <attribute name="invisible">hide_set_button == True</attribute>
            </xpath>
            <xpath expr="//button[@name='action_inventory_history']" position="attributes">
                <attribute name="invisible">hide_set_button == True</attribute>
            </xpath>
            <xpath expr="//button[@name='action_set_inventory_quantity']" position="attributes">
                <attribute name="invisible">hide_set_button == True</attribute>
            </xpath>
            <xpath expr="//button[@name='action_inventory_at_date']" position="attributes">
                <attribute name="invisible">hide_set_button == True</attribute>
            </xpath>

        </field>
    </record>
    
</odoo>
