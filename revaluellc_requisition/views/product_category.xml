<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_product_category_form" model="ir.ui.view">
        <field name="name">inherit.product.category.form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="set_budget"  widget="boolean_toggle"/>
                <field name="requisition_budget" invisible="set_budget == False"/>
            </xpath>
        </field>
    </record>
</odoo>
