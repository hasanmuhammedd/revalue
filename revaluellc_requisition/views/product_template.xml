<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherit_product_template_form" model="ir.ui.view">
        <field name="name">inherit.product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='tracking']" position="after">
                <field name="tracking_by_mac" invisible="tracking not in ['serial']"
                       widget="boolean_toggle"/>
            </xpath>

        </field>
    </record>
</odoo>
